<?xml version="1.0" encoding="utf-8"?>
<!-- Il Tabellone. previewLayout mostra il widget vero nel cassetto invece
     di una schermata finta, cosi si sceglie sapendo cosa si prende. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="100dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/mf_widget_tabellone"
    android:previewLayout="@layout/mf_widget_tabellone"
    android:description="@string/mf_widget_tabellone_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
