<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:weightSum="10">

    <!-- COLONNA SINISTRA: RADAR MAPPA VETTORIALE (Peso 4.5) -->
    <RelativeLayout
        android:id="@+id/widget_map_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4.5"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_radar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Radar Risparmio" />
            
        <!-- Subtle style indicator inside radar -->
        <TextView
            android:id="@+id/widget_map_style_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:text="🎨"
            android:textSize="12sp"
            android:padding="4dp" />
    </RelativeLayout>

    <!-- SEPARATORE CENTRALE -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#222A3C"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp" />

    <!-- COLONNA DESTRA: TOP STAZIONI (Peso 5.5) -->
    <LinearLayout
        android:id="@+id/widget_map_list_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5.5"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingRight="2dp">

        <!-- Title of List -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Radar Carburanti"
            android:textColor="#3B82F6"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:layout_marginBottom="4dp" />

        <!-- Station 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">
            <TextView
                android:id="@+id/widget_map_s1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Carica dati..."
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true"
                android:fontFamily="sans-serif" />
            <TextView
                android:id="@+id/widget_map_s1_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- Station 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">
            <TextView
                android:id="@+id/widget_map_s2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true"
                android:fontFamily="sans-serif" />
            <TextView
                android:id="@+id/widget_map_s2_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- Station 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_map_s3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true"
                android:fontFamily="sans-serif" />
            <TextView
                android:id="@+id/widget_map_s3_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
