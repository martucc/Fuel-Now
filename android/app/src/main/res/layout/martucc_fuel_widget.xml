<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:weightSum="10">

    <!-- COLONNA SINISTRA: METEO (Peso 3.2) -->
    <LinearLayout
        android:id="@+id/widget_weather_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3.2"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="4dp">

        <TextView
            android:id="@+id/widget_weather_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/widget_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20°C"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/widget_weather_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meteo"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- SEPARATORE 1 -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#222A3C"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp" />

    <!-- COLONNA CENTRALE: CARBURANTE + AI SUGGESTION (Peso 4.2) -->
    <LinearLayout
        android:id="@+id/widget_fuel_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4.2"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <!-- Tiny style brush icon in the top left of center -->
        <TextView
            android:id="@+id/widget_style_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_gravity="left"
            android:padding="2dp"
            android:layout_marginBottom="-14dp" />

        <TextView
            android:id="@+id/widget_fuel_station"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carica i dati..."
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_fuel_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            android:textColor="#22C55E"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_ai_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Apri Martucc Fuel"
            android:textColor="#3B82F6"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:ellipsize="end"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- SEPARATORE 2 -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#222A3C"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp" />

    <!-- COLONNA DESTRA: OROLOGIO PREMIUM IOS (Peso 2.6) -->
    <LinearLayout
        android:id="@+id/widget_clock_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.6"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingRight="4dp">

        <TextClock
            android:id="@+id/widget_text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif-light" /> <!-- Ultra elegant thin clock look -->

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oggi"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_clock_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Martucc"
            android:textColor="#3B82F6"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:layout_marginTop="1dp" />
    </LinearLayout>

</LinearLayout>
