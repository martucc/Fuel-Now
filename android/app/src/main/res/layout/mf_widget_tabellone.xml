<?xml version="1.0" encoding="utf-8"?>
<!-- Il Tabellone (4x2). Notte portato sulla schermata home.
     Le cinque tacche in alto sono l'istogramma dell'icona: quella accesa
     e il livello del prezzo, cosi il widget e l'app dicono la stessa cosa
     con lo stesso segno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mf_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mf_sfondo_pieno"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <!-- RIGA A - contesto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <LinearLayout
            android:id="@+id/mf_istogramma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingRight="9dp">

            <ImageView android:id="@+id/mf_tacca_1" android:layout_width="3dp"
                android:layout_height="7dp" android:src="@drawable/mf_tacca"
                android:scaleType="fitXY" android:layout_marginRight="2dp"
                android:contentDescription="@null" />
            <ImageView android:id="@+id/mf_tacca_2" android:layout_width="3dp"
                android:layout_height="11dp" android:src="@drawable/mf_tacca"
                android:scaleType="fitXY" android:layout_marginRight="2dp"
                android:contentDescription="@null" />
            <ImageView android:id="@+id/mf_tacca_3" android:layout_width="3dp"
                android:layout_height="9dp" android:src="@drawable/mf_tacca"
                android:scaleType="fitXY" android:layout_marginRight="2dp"
                android:contentDescription="@null" />
            <ImageView android:id="@+id/mf_tacca_4" android:layout_width="3dp"
                android:layout_height="14dp" android:src="@drawable/mf_tacca"
                android:scaleType="fitXY" android:layout_marginRight="2dp"
                android:contentDescription="@null" />
            <ImageView android:id="@+id/mf_tacca_5" android:layout_width="3dp"
                android:layout_height="6dp" android:src="@drawable/mf_tacca"
                android:scaleType="fitXY" android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/mf_contesto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BENZINA"
            android:textColor="@color/mf_muted"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.10"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/mf_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/mf_muted"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <!-- RIGA B - la risposta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="9dp">

        <TextView
            android:id="@+id/mf_prezzo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8212;"
            android:textColor="@color/mf_ink"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/mf_dove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apri l&#8217;app"
                android:textColor="@color/mf_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/mf_scarto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/mf_ink_2"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.07"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- RIGA C - cosa fare -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="11dp">

        <TextView
            android:id="@+id/mf_verdetto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APRI L&#8217;APP"
            android:textColor="@color/mf_ink_2"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:background="@drawable/mf_pillola"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/mf_portami"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PORTAMI L&#204;  &#8250;"
            android:textColor="@color/mf_accent"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:paddingLeft="10dp"
            android:paddingRight="4dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>
