<?xml version="1.0" encoding="utf-8"?>
<!-- Notte pieno, versione Android 12 e successivi.

     Da Android 12 il sistema decide lui il raggio degli angoli dei widget e
     ritaglia quello che esce: con i nostri 24dp fissi restava una mezzaluna
     di fondo fuori dal ritaglio, visibile come un bordo spesso su un lato.
     system_app_widget_background_radius e il raggio che il lanciatore sta
     gia usando, quindi il fondo finisce esattamente dentro la maschera. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/mf_ground" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <stroke android:width="1dp" android:color="@color/mf_hairline" />
</shape>
